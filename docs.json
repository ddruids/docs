{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "sequoia",
    "name": "Bungee Design System",
    "colors": {
      "primary": "#000000",
      "light": "#000000",
      "dark": "#000000"
    },
    "favicon": "/favicon.svg",
    "navigation": {
      "global": {
        "anchors": [
          {
            "anchor": "Documentation",
            "icon": "book-open-cover",
            "href": "https://mintlify.com/docs"
          },
          {
            "anchor": "Community",
            "icon": "slack",
            "href": "https://mintlify.com/community"
          },
          {
            "anchor": "Blog",
            "icon": "newspaper",
            "href": "https://mintlify.com/blog"
          }
        ]
      },
      "pages": [
        {
          "group": "Get Started",
          "pages": [
            "index",
            "index-copied-2",
            "index-copied-3",
            "index-copied-4",
            "index-copied-5",
            "index-copied-6",
            "index-copied-7",
            "index-copied-8",
            "index-copied-9"
          ]
        },
        {
          "group": "Tokens",
          "pages": [
            "colors-1",
            "type",
            "quickstart"
          ]
        },
        {
          "group": "Components",
          "pages": [
            "Bottomsheet",
            "Cards",
            "Checkbox",
            "Drawer",
            "Ghost",
            "Icons",
            "Modal",
            "Spinner",
            "Toasts",
            "Toggle",
            "Tooltip"
          ]
        },
        {
          "group": "Essentials",
          "pages": [
            "essentials/markdown",
            "essentials/code",
            "essentials/images",
            "essentials/settings",
            "essentials/navigation",
            "essentials/reusable-snippets"
          ]
        },
        "colors"
      ]
    },
    "logo": {
      "light": "/images/bungee_logo_P_FC4x.webp",
      "dark": "/logo/bungee white.svg"
    },
    "navbar": {
      "links": [
        {
          "label": "Support",
          "href": "mailto:hi@mintlify.com"
        }
      ],
      "primary": {
        "type": "button",
        "label": "Dashboard",
        "href": "https://dashboard.mintlify.com"
      }
    },
    "footer": {
      "socials": {
        "x": "https://x.com/mintlify",
        "github": "https://github.com/mintlify",
        "linkedin": "https://linkedin.com/company/mintlify"
      }
    },
    "appearance": {
      "strict": false,
      "default": "light"
    },
    "background": {
      "decoration": "grid"
    },
    "fonts": {
      "heading": {
        "family": "Geist"
      },
      "body": {
        "family": "Geist"
      }
    }
  }